; Engine configuration file.
; Proyecto AntWars — hormiguero virtual idle para el escritorio.
; Abrir con Godot 4.7.x (versión estándar, no hace falta .NET).

config_version=5

[application]

config/name="AntWars"
config/description="Hormiguero virtual idle para el escritorio: simulación realista de una colonia de Messor barbarus."
config/version="0.1.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.08, 0.07, 0.06, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=560
window/size/resizable=true
window/per_pixel_transparency/allowed=true
window/size/transparent=true
window/stretch/mode="disabled"
window/energy_saving/keep_screen_on=false

[internationalization]

locale/translations=PackedStringArray()

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
